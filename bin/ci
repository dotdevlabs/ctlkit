#!/usr/bin/env bash
set -euo pipefail

echo "==> gofmt"
GOFMT_OUT=$(gofmt -l .)
if [ -n "$GOFMT_OUT" ]; then
  echo "gofmt found unformatted files:"
  echo "$GOFMT_OUT"
  exit 1
fi

echo "==> go vet"
go vet ./...

echo "==> golangci-lint"
golangci-lint run

echo "==> go test"
go test ./... -race -coverprofile=coverage.out -covermode=atomic

echo "==> coverage gate"
COVERAGE=$(go tool cover -func=coverage.out | grep "^total:" | awk '{print $3}' | tr -d '%')
echo "    total coverage: ${COVERAGE}%"
awk -v cov="$COVERAGE" 'BEGIN { if (cov+0 < 70) { printf "FAIL: coverage %.1f%% < 70%% threshold\n", cov+0; exit 1 } }'

echo "==> go build"
go build ./...

echo "==> all checks passed"
